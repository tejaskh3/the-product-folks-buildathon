# From openrouter.ai/keys (platform key: pays for users on our plans)
OPENROUTER_API_KEY=
# Optional: override the default model (see lib/models.ts)
OPENROUTER_MODEL=
# How the paper goes to the model (lib/paperSending.ts). "full" (default): the whole PDF on every call.
# "digest": the plan reads the whole PDF and also writes a text digest (saved on papers.digest); later
# calls get the digest plus a PDF of only the pages they cite. Needs migration 20261013130000_paper_digest.
# Compare both on one paper first: scripts/eval-sending.ts.
PAPER_SENDING=full
# Optional: separate platform keys per tier, each with its own spending limit set in OpenRouter.
# Unset → OPENROUTER_API_KEY pays for everyone.
OPENROUTER_KEY_FREE=
OPENROUTER_KEY_PAID=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts users' own OpenRouter keys.
KEY_ENCRYPTION_SECRET=
# "true" turns the paper quota on. Off: nobody is denied, papers are still counted.
BILLING_ENABLED=
# Fair-use cap on questions per user per day on our key (default 100).
DAILY_QUESTION_CAP=
# Free papers per IP (IPv6: per /64) per day, across all users (default 4). Applies with billing on.
FREE_PAPERS_PER_IP_DAY=
# Keys the HMAC of client IPs (the raw IP is never stored). Unset → KEY_ENCRYPTION_SECRET is used.
IP_HASH_SECRET=
# Daily spend alert (Vercel Cron → /api/cron/spend). The same secret guards /api/cron/uploads,
# the daily cleanup of abandoned big uploads.
CRON_SECRET=
SPEND_ALERT_USD=5
SPEND_ALERT_WEBHOOK=
# Dodo Payments (dashboard → Developer → API keys / Webhooks). test_mode until launch, then live_mode.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Webhook endpoint: https://<site>/api/billing/webhook (subscription.* and payment.* events)
DODO_PAYMENTS_WEBHOOK_SECRET=
# Product ids of the three monthly subscriptions ($2 BYOK, $5 Starter, $10 Pro)
DODO_PRODUCT_BYOK=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PRO=
# Shown on the "Still activating…" page; unset → "reply to your receipt email"
NEXT_PUBLIC_SUPPORT_EMAIL=
# Clerk user ids allowed to open /admin (comma-separated)
ADMIN_USER_IDS=
# Optional: secret mixed into the IP hash that rate-limits signed-out feedback (raw IPs are never stored).
# Unset → KEY_ENCRYPTION_SECRET is used.
IP_HASH_SECRET=
